<Project Sdk="Microsoft.NET.Sdk">

  <!-- Console checks for the Minecraft pack: RCON packet tests, command templates, and a real Paper server run
       in a scratch folder. Not part of GiftDeck.exe (GiftDeck.csproj excludes tests\**).
       Run: MinecraftHarness.exe unit
       or:  MinecraftHarness.exe live (scratch folder) [paper version] -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\GiftDeck.csproj" />
  </ItemGroup>

</Project>
