<UserControl x:Class="GiftDeck.Views.TtsMuteButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Quick text-to-speech mute: a speaker icon; red with "TTS muted" while muted. Used in the Live panel and on Go LIVE. -->
    <Button x:Name="Btn" Style="{StaticResource Ghost}" MinHeight="0" Padding="8,4" Click="Btn_Click"
            AutomationProperties.Name="Mute text to speech">
        <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="Glyph" FontFamily="{StaticResource IconFont}" Text="&#xE767;" FontSize="15" VerticalAlignment="Center"/>
            <TextBlock x:Name="Word" Text="TTS muted" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="7,0,0,0" Visibility="Collapsed"/>
        </StackPanel>
    </Button>
</UserControl>
