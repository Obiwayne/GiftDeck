<Window x:Class="GiftDeck.Views.SoundLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GiftDeck.Views"
        Title="Sound library" Width="640" Height="560" MinWidth="520" MinHeight="420"
        Background="{StaticResource BgBrush}" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" ShowInTaskbar="False">
    <DockPanel Margin="24,20,24,18">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Sound library" Style="{StaticResource H1}"/>
            <TextBlock Text="Search MyInstants, the same library TikFinity uses. Press play to hear a clip; Use this sound saves it to your PC for the event." Style="{StaticResource Muted}" Margin="0,4,0,14"/>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" KeyDown="SearchBox_KeyDown" local:Placeholder.Text="For example: best friends, airhorn, fail"/>
                <Button Grid.Column="1" Content="Search" Style="{StaticResource Primary}" Click="Search_Click" Margin="8,0,0,0"/>
            </Grid>
        </StackPanel>

        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock x:Name="Status" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,260,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="PlayButton" Content="Play" Click="Play_Click" Margin="0,0,6,0" MinWidth="70"/>
                <Button Content="Stop" Style="{StaticResource Ghost}" Click="Stop_Click" Margin="0,0,14,0"/>
                <Button Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0"/>
                <Button x:Name="UseButton" Content="Use this sound" Style="{StaticResource Primary}" Click="Use_Click" IsEnabled="False"/>
            </StackPanel>
        </Grid>

        <Border Style="{StaticResource Card}" Padding="8">
            <ListBox x:Name="Results" ItemContainerStyle="{StaticResource FeedItem}" SelectionChanged="Results_SelectionChanged" MouseDoubleClick="Results_DoubleClick"/>
        </Border>
    </DockPanel>
</Window>
