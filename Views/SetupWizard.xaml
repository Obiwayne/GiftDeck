<UserControl x:Class="GiftDeck.Views.SetupWizard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GiftDeck.Views">
    <!-- Covers the whole window when GiftDeck opens: checks (and if needed, walks through) everything
         GiftDeck needs, and only then lets the user into the app. -->
    <Grid Background="{StaticResource BgBrush}">
        <Border Style="{StaticResource Card}" Width="960" Height="560" Margin="40" Padding="0"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Steps -->
                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Padding="26,26,20,26">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,22">
                            <Image Source="{StaticResource LogoImage}" Width="34" Height="34" Margin="0,0,10,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="GiftDeck" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                <TextBlock x:Name="Subtitle" Text="Getting ready" Style="{StaticResource Muted}" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel x:Name="StepList"/>
                    </DockPanel>
                </Border>

                <!-- The current step -->
                <DockPanel Grid.Column="1" Margin="34,30,34,26">
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,18,0,0">
                        <Button x:Name="SkipButton" DockPanel.Dock="Right" Content="Skip this step" Style="{StaticResource Ghost}" FontSize="12" Click="Skip_Click" VerticalAlignment="Bottom"/>
                        <StackPanel x:Name="Buttons" Orientation="Horizontal" VerticalAlignment="Bottom"/>
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="StepNumber" Style="{StaticResource Muted}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock x:Name="StepTitle" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock x:Name="StepBody" FontSize="14" LineHeight="22" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0"/>

                            <StackPanel x:Name="UsernamePanel" Margin="0,18,0,0" Visibility="Collapsed">
                                <TextBlock Text="TikTok username" Style="{StaticResource Label}"/>
                                <TextBox x:Name="UsernameBox" Width="320" HorizontalAlignment="Left" local:Placeholder.Text="yourname" KeyDown="UsernameBox_KeyDown"/>
                            </StackPanel>

                            <StackPanel x:Name="ReadyRows" Margin="0,18,0,0" Visibility="Collapsed"/>

                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                <Ellipse x:Name="StatusSpinner" Width="14" Height="14" StrokeThickness="2" StrokeDashArray="5 3"
                                         Stroke="{StaticResource AccentBrush}" RenderTransformOrigin="0.5,0.5" Margin="0,0,10,0"
                                         VerticalAlignment="Center" Visibility="Collapsed">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform x:Name="StatusSpin"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <TextBlock x:Name="StepStatus" FontSize="13" TextWrapping="Wrap" MaxWidth="560" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ProgressBar x:Name="StepProgress" Height="5" Minimum="0" Maximum="1" Margin="0,10,0,0" Visibility="Collapsed"
                                         Background="{StaticResource LineBrush}" Foreground="{StaticResource AccentBrush}" BorderThickness="0"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
