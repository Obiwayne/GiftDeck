<UserControl x:Class="GiftDeck.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,28" MaxWidth="900" HorizontalAlignment="Left">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="Import profile" Style="{StaticResource Ghost}" Click="Import_Click" Margin="0,0,8,0"/>
                    <Button Content="+ New profile" Style="{StaticResource Primary}" Click="New_Click"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Profiles" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,18" TextWrapping="Wrap"
                               Text="One setup per game or show. A profile holds its own events, overlays (menu board, goals, counters) and LIVE title and category. Accounts, keys, OBS and music are shared by all profiles."/>
                </StackPanel>
            </DockPanel>

            <ItemsControl x:Name="ProfileList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,10">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Use this profile" Style="{StaticResource Primary}" Click="Switch_Click" Tag="{Binding Name}" Visibility="{Binding SwitchVisibility}" Margin="0,0,6,0"/>
                                    <Button Content="Duplicate" Click="Duplicate_Click" Tag="{Binding Name}" Margin="0,0,6,0"/>
                                    <Button Content="Rename" Click="Rename_Click" Tag="{Binding Name}" Margin="0,0,6,0"/>
                                    <Button Content="Export" Click="Export_Click" Tag="{Binding Name}" Margin="0,0,6,0"/>
                                    <Button Content="Delete" Style="{StaticResource Danger}" Click="Delete_Click" Tag="{Binding Name}" Visibility="{Binding SwitchVisibility}"/>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/>
                                        <Border Background="{StaticResource AccentDimBrush}" CornerRadius="9" Padding="8,1" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="{Binding ActiveVisibility}">
                                            <TextBlock Text="IN USE" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="Message" Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"/>

            <Border Style="{StaticResource SubCard}" Margin="0,16,0,0">
                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                           Text="Export saves a profile as one .giftdeck file, including the sound files and board pictures it uses, so you can back it up or share it. Import adds a .giftdeck file as a new profile. Key presses depend on the game's own shortcuts, so check them after importing someone else's profile."/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
