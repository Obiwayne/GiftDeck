<UserControl x:Class="GiftDeck.Views.GamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Supported games: find the game, install its mods in one click, load a ready-made preset.
         Skeleton: filled in by the Game Packs package. -->
    <Grid Margin="32,28,32,24">
        <StackPanel>
            <TextBlock Text="Games" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" Text="Pick a game, install its mod in one click, and start from a ready-made set of events."/>
        </StackPanel>
    </Grid>
</UserControl>
