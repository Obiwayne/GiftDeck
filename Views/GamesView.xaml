<UserControl x:Class="GiftDeck.Views.GamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GiftDeck.Views"
             PreviewKeyDown="View_PreviewKeyDown">
    <!-- The game library: search, tier filters and a grid of cover tiles; clicking one opens its page.
         A game's page depends on its tier: "ready" (mods or a server GiftDeck installs, plus presets),
         "console" (set-up guide, connection card, its commands) or "keys" (set-up guide, key ideas).
         Tiles and the rows inside the cards are built in code (GamesView.xaml.cs, GameCatalogTile.cs). -->
    <UserControl.Resources>
        <!-- Filter chips above the grid -->
        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="GroupName" Value="GameTier"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="17" Padding="14,7,12,8" Background="{StaticResource Panel2Brush}"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Panel3Brush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentDimBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#A08CFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ChipText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ChipCount" TargetType="TextBlock" BasedOn="{StaticResource ChipText}">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Opacity" Value="0.75"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
        <Style x:Key="SectionIntro" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="LineHeight" Value="19"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel x:Name="PageBody" Margin="32,28,32,28" MaxWidth="1320" HorizontalAlignment="Left">

            <!-- ===================== The list of games ===================== -->
            <StackPanel x:Name="ListHeader">
                <DockPanel Margin="0,0,0,16" LastChildFill="True">
                    <!-- Search: name, genre, short line -->
                    <Grid DockPanel.Dock="Right" Width="320" VerticalAlignment="Bottom" Margin="16,0,0,0">
                        <TextBox x:Name="SearchBox" Padding="16,0,15,0" TextChanged="Search_Changed"
                                 AutomationProperties.Name="Search games by name or genre" ToolTip="Search by name or genre (Ctrl+F)"/>
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center" HorizontalAlignment="Left" Margin="12,1,0,0" IsHitTestVisible="False"/>
                        <TextBlock x:Name="SearchHint" Text="Search games or genres" Style="{StaticResource Muted}" FontSize="13"
                                   VerticalAlignment="Center" Margin="34,0,0,0" IsHitTestVisible="False" TextWrapping="NoWrap"/>
                        <Button x:Name="ClearSearchButton" Style="{StaticResource Ghost}" HorizontalAlignment="Right" MinHeight="0" Padding="8,4"
                                Margin="0,0,3,0" Click="ClearSearch_Click" Visibility="Collapsed" ToolTip="Clear search (Esc)"
                                AutomationProperties.Name="Clear search">
                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                        </Button>
                    </Grid>
                    <StackPanel>
                        <TextBlock Text="Games" Style="{StaticResource H1}"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                                   Text="Pick a game to see how GiftDeck works with it: one-click installs, a server console, or the game's own keys."/>
                    </StackPanel>
                </DockPanel>

                <!-- Tier filters, with how many games each has (for the current search) -->
                <DockPanel Margin="0,0,0,10">
                    <TextBlock x:Name="ResultText" DockPanel.Dock="Right" Style="{StaticResource Muted}" VerticalAlignment="Top" Margin="12,9,0,0" TextWrapping="NoWrap"/>
                    <WrapPanel x:Name="ChipsPanel">
                        <RadioButton x:Name="ChipAll" Style="{StaticResource Chip}" Tag="" IsChecked="True" Checked="Chip_Checked"
                                     AutomationProperties.Name="Show all games">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="All" Style="{StaticResource ChipText}"/>
                                <TextBlock x:Name="CountAll" Style="{StaticResource ChipCount}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="ChipReady" Style="{StaticResource Chip}" Tag="ready" Checked="Chip_Checked"
                                     AutomationProperties.Name="Show games that are ready to go"
                                     ToolTip="GiftDeck installs everything and has ready-made events">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="#7C5CFF" VerticalAlignment="Center" Margin="0,1,8,0"/>
                                <TextBlock Text="Ready to go" Style="{StaticResource ChipText}"/>
                                <TextBlock x:Name="CountReady" Style="{StaticResource ChipCount}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="ChipConsole" Style="{StaticResource Chip}" Tag="console" Checked="Chip_Checked"
                                     AutomationProperties.Name="Show games with a server console"
                                     ToolTip="Gifts run commands on the game's own server">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="#38BDF8" VerticalAlignment="Center" Margin="0,1,8,0"/>
                                <TextBlock Text="Server console" Style="{StaticResource ChipText}"/>
                                <TextBlock x:Name="CountConsole" Style="{StaticResource ChipCount}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="ChipKeys" Style="{StaticResource Chip}" Tag="keys" Checked="Chip_Checked"
                                     AutomationProperties.Name="Show games played with key presses"
                                     ToolTip="Gifts press the game's own keys">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="#F59E0B" VerticalAlignment="Center" Margin="0,1,8,0"/>
                                <TextBlock Text="Key presses" Style="{StaticResource ChipText}"/>
                                <TextBlock x:Name="CountKeys" Style="{StaticResource ChipCount}"/>
                            </StackPanel>
                        </RadioButton>
                    </WrapPanel>
                </DockPanel>
            </StackPanel>

            <Button x:Name="BackButton" Content="&#x2190;  All games" Style="{StaticResource Ghost}" HorizontalAlignment="Left"
                    Margin="-14,0,0,10" Click="Back_Click" Visibility="Collapsed" ToolTip="Back to all games (Esc)"/>

            <local:GameCatalogGrid x:Name="CardsPanel" Margin="0,6,0,0" KeyboardNavigation.TabNavigation="Local"/>

            <!-- Nothing matches the search / filter, or there are no packs at all -->
            <Border x:Name="EmptyPanel" Style="{StaticResource Card}" Padding="28,34" Margin="0,6,0,0" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="28" Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock x:Name="EmptyTitle" Style="{StaticResource H2}" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock x:Name="EmptyText" Style="{StaticResource Muted}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,0" MaxWidth="520"/>
                    <Button x:Name="EmptyButton" Content="Show all games" HorizontalAlignment="Center" Margin="0,16,0,0" Click="ShowAll_Click"/>
                </StackPanel>
            </Border>

            <!-- ===================== A game's page ===================== -->
            <StackPanel x:Name="DetailPanel" Visibility="Collapsed" Margin="0,4,0,0">

                <!-- Hero: cover, tier, name, description; the cover blurred behind it -->
                <Border x:Name="HeroCard" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,14">
                    <Grid x:Name="HeroGrid">
                        <Image x:Name="HeroBackdrop" Stretch="UniformToFill" Margin="-60" Width="0" Height="0" Tag="0.28" IsHitTestVisible="False" Visibility="Collapsed">
                            <Image.Effect>
                                <BlurEffect Radius="48" KernelType="Gaussian" RenderingBias="Performance"/>
                            </Image.Effect>
                        </Image>
                        <Border IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#99171A23" Offset="0"/>
                                    <GradientStop Color="#E6171A23" Offset="0.55"/>
                                    <GradientStop Color="#F2171A23" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Grid Margin="22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CoverFrame" Width="368" Height="172" CornerRadius="10" VerticalAlignment="Top" Margin="0,0,24,0"
                                    Background="{StaticResource Panel2Brush}" BorderBrush="#33FFFFFF" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="26" ShadowDepth="8" Direction="270" Opacity="0.5" Color="Black"/>
                                </Border.Effect>
                                <Grid x:Name="CoverClip">
                                    <ContentControl x:Name="CoverFallback" Focusable="False" IsTabStop="False"/>
                                    <Image x:Name="CoverImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <WrapPanel x:Name="HeroBadges" Margin="0,0,0,8"/>
                                <TextBlock x:Name="TitleText" FontSize="26" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ShortText" Foreground="{StaticResource TextBrush}" Opacity="0.85" FontSize="13.5" Margin="0,4,0,0"/>
                                <TextBlock x:Name="DescText" Style="{StaticResource Muted}" Margin="0,8,0,0" LineHeight="19"/>
                                <Border x:Name="WarningBorder" Style="{StaticResource SubCard}" Margin="0,12,0,0" Padding="10,8" HorizontalAlignment="Left">
                                    <TextBlock x:Name="WarningText" Foreground="{StaticResource WarnBrush}"/>
                                </Border>
                                <Border x:Name="LinkBorder" Style="{StaticResource SubCard}" Margin="0,10,0,0" Padding="10,8" HorizontalAlignment="Left">
                                    <StackPanel>
                                        <TextBlock x:Name="LinkText" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="LinkDetail" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <WrapPanel x:Name="HeroButtons" Margin="0,14,0,0">
                                    <Button x:Name="GetGameButton" Click="GetGame_Click" Margin="0,0,8,0"/>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ============ Ready to go: mods / server and presets (unchanged behaviour) ============ -->
                <StackPanel x:Name="ReadyPanel">
                    <!-- Where the game is -->
                    <Border x:Name="GameCard" Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Your game" Style="{StaticResource H2}" Margin="0,0,0,12"/>
                            <StackPanel x:Name="GameRows"/>
                        </StackPanel>
                    </Border>

                    <!-- Before you install -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Before you install" Style="{StaticResource H2}" Margin="0,0,0,12"/>
                            <StackPanel x:Name="ReqRows"/>
                        </StackPanel>
                    </Border>

                    <!-- A pack that runs a server on this PC (Minecraft) shows the server's controls instead of mods.
                         The panel brings its own cards, so this section has a heading rather than a card around it. -->
                    <StackPanel x:Name="ServerCard" Margin="0,4,0,0" Visibility="Collapsed">
                        <TextBlock Text="Your server" Style="{StaticResource H2}" Margin="2,0,0,4"/>
                        <TextBlock x:Name="JoinText" Style="{StaticResource Muted}" Margin="2,0,0,12"/>
                        <ContentControl x:Name="ServerHost" Focusable="False" IsTabStop="False"/>
                    </StackPanel>

                    <!-- Mods -->
                    <Border x:Name="ModsCard" Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <Button x:Name="CheckButton" DockPanel.Dock="Right" Content="Check for updates" Style="{StaticResource Ghost}" FontSize="12" Click="Check_Click"/>
                                <TextBlock Text="Mods" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock x:Name="ModsIntro" Style="{StaticResource SectionIntro}"/>
                            <StackPanel x:Name="ComponentRows"/>

                            <Border x:Name="ManualPanel" Style="{StaticResource SubCard}" Margin="0,4,0,12" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock x:Name="ManualTitle" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="ManualText" Style="{StaticResource Muted}" Margin="0,4,0,10"/>
                                    <WrapPanel>
                                        <Button x:Name="ManualOpenButton" Style="{StaticResource Primary}" Click="ManualOpen_Click" Margin="0,0,8,0"/>
                                        <Button Content="I've downloaded it: choose the file…" Click="ManualPick_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Button x:Name="InstallButton" Style="{StaticResource Primary}" FontSize="15" MinHeight="44" Padding="30,0" Click="Install_Click" Margin="0,0,10,0"/>
                                <Button x:Name="UninstallButton" Content="Uninstall" Style="{StaticResource Danger}" MinHeight="44" Click="Uninstall_Click"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Ellipse x:Name="StatusSpinner" Width="14" Height="14" StrokeThickness="2" StrokeDashArray="5 3"
                                         Stroke="{StaticResource AccentBrush}" RenderTransformOrigin="0.5,0.5" Margin="0,0,10,0"
                                         VerticalAlignment="Center" Visibility="Collapsed">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform x:Name="StatusSpin"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <TextBlock x:Name="StatusText" FontSize="13" MaxWidth="820" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ProgressBar x:Name="Bar" Height="5" Minimum="0" Maximum="1" Margin="0,10,0,0" Visibility="Collapsed"
                                         Background="{StaticResource LineBrush}" Foreground="{StaticResource AccentBrush}" BorderThickness="0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ Server console / Key presses: guide next to the connection or key set-up ============ -->
                <Grid x:Name="SetupGrid" Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="SetupMainColumn" Width="*"/>
                        <ColumnDefinition x:Name="SetupSideColumn" Width="420"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- How to set it up: numbered steps -->
                    <Border x:Name="GuideCard" Style="{StaticResource Card}" Margin="0,0,0,14" VerticalAlignment="Stretch">
                        <StackPanel>
                            <TextBlock Text="How to set it up" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="GuideIntro" Style="{StaticResource SectionIntro}"/>
                            <StackPanel x:Name="GuideRows"/>
                        </StackPanel>
                    </Border>

                    <!-- Side: the console connection, or sending keys to the game's window -->
                    <StackPanel x:Name="SideColumn" Grid.Column="1" Margin="14,0,0,0">
                        <Border x:Name="ConsoleCard" Style="{StaticResource Card}" Margin="0,0,0,14">
                            <ContentControl x:Name="ConsoleHost" Focusable="False" IsTabStop="False"/>
                        </Border>
                        <Border x:Name="WindowCard" Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Send the keys to the game" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="WindowIntro" Style="{StaticResource SectionIntro}"/>
                                <Button x:Name="FocusWindowButton" Style="{StaticResource Primary}" HorizontalAlignment="Left" Click="FocusWindow_Click"/>
                                <TextBlock x:Name="FocusWindowStatus" Margin="0,10,0,0" FontSize="12.5" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Console: the game's commands -->
                <Border x:Name="CommandsCard" Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,4">
                            <Button DockPanel.Dock="Right" Content="Open Events" Style="{StaticResource Ghost}" FontSize="12" Click="OpenEvents_Click"/>
                            <TextBlock Text="Commands" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock x:Name="CommandsIntro" Style="{StaticResource SectionIntro}"/>
                        <StackPanel x:Name="CommandRows"/>
                    </StackPanel>
                </Border>

                <!-- Keys: key ideas -->
                <Border x:Name="KeysCard" Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,4">
                            <Button DockPanel.Dock="Right" Content="Open Events" Style="{StaticResource Ghost}" FontSize="12" Click="OpenEvents_Click"/>
                            <TextBlock Text="Key ideas" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource SectionIntro}"
                                   Text="The game's usual keys and a gift each one suits. Add as event opens the event editor with the key press filled in: you pick the gift or trigger."/>
                        <StackPanel x:Name="KeyRows" Grid.IsSharedSizeScope="True"/>
                        <TextBlock x:Name="KeysStatus" Margin="0,12,0,0" FontSize="12.5" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- Presets -->
                <Border x:Name="PresetsCard" Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Ready-made events" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                        <TextBlock Style="{StaticResource SectionIntro}"
                                   Text="A preset is a profile with events and a gift board already set up for this game. Using one adds it as a new profile and switches to it; your other profiles aren't changed."/>
                        <StackPanel x:Name="PresetRows"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
