<UserControl x:Class="GiftDeck.Views.MiniPlayer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <DockPanel Margin="0,0,0,12">
            <Border DockPanel.Dock="Left" Width="60" Height="60" CornerRadius="8" Background="{StaticResource Panel2Brush}" Margin="0,0,12,0" ClipToBounds="True">
                <Grid>
                    <TextBlock Text="♪" FontSize="24" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Image x:Name="Cover" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Text="Nothing playing" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                <TextBlock x:Name="ArtistText" Text="Press Play for music" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,2,0,6"/>
                <ProgressBar x:Name="Progress" Height="4" Minimum="0" Maximum="1" Value="0" Background="{StaticResource Panel3Brush}" Foreground="{StaticResource AccentBrush}" BorderThickness="0"/>
            </StackPanel>
        </DockPanel>
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="34"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="PlayButton" Content="Play" Style="{StaticResource Primary}" MinWidth="76" Click="PlayPause_Click"/>
            <Button x:Name="SkipButton" Grid.Column="1" Content="Skip" Click="Skip_Click" Margin="6,0,12,0"/>
            <Slider x:Name="VolumeSlider" Grid.Column="2" Minimum="0" Maximum="100" VerticalAlignment="Center" ValueChanged="Volume_Changed" ToolTip="Music volume"/>
            <TextBlock x:Name="VolumeText" Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Muted}"/>
        </Grid>
        <ComboBox x:Name="GenreBox" SelectionChanged="Genre_Changed" ToolTip="Style of music"/>
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" Margin="0,6,0,0" FontSize="12"/>
    </StackPanel>
</UserControl>
