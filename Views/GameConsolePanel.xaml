<UserControl x:Class="GiftDeck.Views.GameConsolePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GiftDeck.Views"
             Loaded="Panel_Loaded" Unloaded="Panel_Unloaded">
    <!-- How MayhemDeck reaches a "console" game's server: where it is, its password, and a test.
         Hosted by the Games page; talks to the game's ConsoleTarget (Services\GameLink\ConsoleTarget.cs). -->
    <StackPanel>
        <DockPanel Margin="0,0,0,14">
            <Border x:Name="StatusPill" DockPanel.Dock="Right" VerticalAlignment="Top" CornerRadius="11" Padding="10,4,11,5"
                    Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Margin="12,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" FontSize="12" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                </StackPanel>
            </Border>
            <StackPanel>
                <TextBlock Text="Connection" Style="{StaticResource H2}"/>
                <TextBlock x:Name="SubText" Style="{StaticResource Muted}" Margin="0,3,0,0"/>
            </StackPanel>
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="104"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="Server address" Style="{StaticResource Label}"/>
                <TextBox x:Name="HostBox" TextChanged="Field_Changed" ToolTip="127.0.0.1 when the server runs on this PC"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,0,12">
                <TextBlock Text="Port" Style="{StaticResource Label}"/>
                <TextBox x:Name="PortBox" TextChanged="Field_Changed" PreviewTextInput="Port_PreviewTextInput"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,0,0,12">
                <TextBlock x:Name="PasswordLabel" Text="Password" Style="{StaticResource Label}"/>
                <local:SecretBox x:Name="PasswordBox" TextChanged="Field_Changed"/>
            </StackPanel>
            <StackPanel x:Name="PlayerPanel" Grid.Row="2" Grid.ColumnSpan="3" Margin="0,0,0,12">
                <TextBlock x:Name="PlayerLabel" Text="Your player name" Style="{StaticResource Label}"/>
                <TextBox x:Name="PlayerBox" TextChanged="Field_Changed"/>
            </StackPanel>
        </Grid>

        <WrapPanel Margin="0,2,0,0">
            <Button x:Name="SaveButton" Content="Save" Style="{StaticResource Primary}" Padding="22,0" Click="Save_Click" Margin="0,0,8,6"/>
            <Button x:Name="TestButton" Content="Test connection" Click="Test_Click" Margin="0,0,8,6"/>
        </WrapPanel>
        <TextBlock x:Name="ResultText" FontSize="12.5" Margin="0,4,0,0" Visibility="Collapsed"/>

        <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,16,0,14"/>

        <TextBlock Text="Send a command" Style="{StaticResource Label}"/>
        <DockPanel>
            <Button x:Name="SendButton" DockPanel.Dock="Right" Content="Send" Click="Send_Click" Margin="8,0,0,0"/>
            <Grid>
                <TextBox x:Name="CommandBox" FontFamily="Consolas" PreviewKeyDown="CommandBox_PreviewKeyDown"
                         AutomationProperties.Name="Command to send to the server"/>
                <TextBlock x:Name="CommandHint" Style="{StaticResource Muted}" FontFamily="Consolas" Margin="10,0,0,0" VerticalAlignment="Center"
                           IsHitTestVisible="False" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </DockPanel>
        <Border x:Name="OutputBorder" Style="{StaticResource SubCard}" Margin="0,8,0,0" Padding="10,8" Visibility="Collapsed">
            <ScrollViewer x:Name="OutputScroll" MaxHeight="170" VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="OutputText" FontFamily="Consolas" FontSize="12" IsReadOnly="True" TextWrapping="Wrap"
                         Background="Transparent" BorderThickness="0" MinHeight="0" Padding="0">
                    <TextBox.Template>
                        <ControlTemplate TargetType="TextBox">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </ControlTemplate>
                    </TextBox.Template>
                </TextBox>
            </ScrollViewer>
        </Border>
    </StackPanel>
</UserControl>
