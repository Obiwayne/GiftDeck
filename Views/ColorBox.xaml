<UserControl x:Class="GiftDeck.Views.ColorBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- A colour setting: a swatch that opens a picker, next to the hex code for exact values. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <ToggleButton x:Name="SwatchButton" Width="34" Height="34" Margin="0,0,6,0" Cursor="Hand" Focusable="True"
                      ToolTip="Pick a colour" Click="Swatch_Click">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Frame" CornerRadius="7" BorderThickness="2" BorderBrush="{StaticResource LineBrush}" Background="{StaticResource BgBrush}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
            <Grid Margin="3">
                <!-- Blank (use the default): a diagonal line through an empty square -->
                <Border x:Name="EmptyMark" CornerRadius="4" BorderBrush="{StaticResource MutedBrush}" BorderThickness="1" ClipToBounds="True">
                    <Line X1="0" Y1="22" X2="22" Y2="0" Stroke="{StaticResource DangerBrush}" StrokeThickness="1.5" Stretch="Fill"/>
                </Border>
                <Border x:Name="SwatchFill" CornerRadius="4"/>
            </Grid>
        </ToggleButton>
        <TextBox x:Name="HexBox" Grid.Column="1" FontFamily="Consolas" VerticalContentAlignment="Center"
                 LostKeyboardFocus="HexBox_LostFocus" KeyDown="HexBox_KeyDown"/>

        <Popup x:Name="PickerPopup" PlacementTarget="{Binding ElementName=SwatchButton}" Placement="Bottom" VerticalOffset="6"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Closed="Popup_Closed">
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,8,8">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.45"/>
                </Border.Effect>
                <StackPanel Width="236">
                    <TextBlock Text="Quick colours" Style="{StaticResource Label}"/>
                    <WrapPanel x:Name="QuickPanel" Margin="0,2,0,10"/>

                    <TextBlock Text="Any colour" Style="{StaticResource Label}"/>
                    <!-- Saturation left to right, brightness top to bottom, for the hue picked below -->
                    <Grid x:Name="SvArea" Width="236" Height="140" Margin="0,2,0,8" Cursor="Cross" Background="Transparent"
                          MouseLeftButtonDown="Sv_MouseDown" MouseMove="Sv_MouseMove" MouseLeftButtonUp="Sv_MouseUp">
                        <Border x:Name="HueFill" CornerRadius="6"/>
                        <Border CornerRadius="6">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border CornerRadius="6">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0"/>
                                    <GradientStop Color="#FF000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Canvas IsHitTestVisible="False">
                            <Ellipse x:Name="SvThumb" Width="14" Height="14" Stroke="White" StrokeThickness="2">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="0" Opacity="0.9"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Canvas>
                    </Grid>
                    <Grid x:Name="HueArea" Height="16" Margin="0,0,0,10" Cursor="Hand" Background="Transparent"
                          MouseLeftButtonDown="Hue_MouseDown" MouseMove="Hue_MouseMove" MouseLeftButtonUp="Hue_MouseUp">
                        <Border CornerRadius="8">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FF0000" Offset="0"/>
                                    <GradientStop Color="#FFFF00" Offset="0.1667"/>
                                    <GradientStop Color="#00FF00" Offset="0.3333"/>
                                    <GradientStop Color="#00FFFF" Offset="0.5"/>
                                    <GradientStop Color="#0000FF" Offset="0.6667"/>
                                    <GradientStop Color="#FF00FF" Offset="0.8333"/>
                                    <GradientStop Color="#FF0000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Canvas IsHitTestVisible="False">
                            <Border x:Name="HueThumb" Width="8" Height="20" Canvas.Top="-2" CornerRadius="3" BorderBrush="White" BorderThickness="2"/>
                        </Canvas>
                    </Grid>

                    <DockPanel>
                        <Border x:Name="PreviewFill" DockPanel.Dock="Left" Width="34" Height="30" CornerRadius="6" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Margin="0,0,8,0"/>
                        <Button x:Name="ClearButton" DockPanel.Dock="Right" Content="Use default" Style="{StaticResource Small}" Margin="8,0,0,0" Click="Clear_Click"/>
                        <TextBox x:Name="PopupHex" FontFamily="Consolas" VerticalContentAlignment="Center" KeyDown="PopupHex_KeyDown" LostKeyboardFocus="PopupHex_LostFocus"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
