<UserControl x:Class="GiftDeck.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32,28,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Dashboard" Style="{StaticResource H1}"/>
            <TextBlock Text="What is coming in from your LIVE, and which events it set off." Style="{StaticResource Muted}" Margin="0,4,0,18"/>
        </StackPanel>

        <UniformGrid Grid.Row="1" Columns="3" Margin="-6,0,-6,18">
            <Border Style="{StaticResource Card}" Margin="6,0">
                <StackPanel>
                    <TextBlock x:Name="TikTitle" Text="TikTok LIVE" Style="{StaticResource H2}"/>
                    <TextBlock x:Name="TikStatus" Style="{StaticResource Muted}" Margin="0,6,0,12" Text="Checking"/>
                    <Button x:Name="TikButton" Content="Launch TikFinity" Click="LaunchTik_Click" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="6,0">
                <StackPanel>
                    <TextBlock Text="OBS" Style="{StaticResource H2}"/>
                    <TextBlock x:Name="ObsStatus" Style="{StaticResource Muted}" Margin="0,6,0,12" Text="Not connected"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ObsButton" Content="Connect" Click="ConnectObs_Click" Margin="0,0,8,0"/>
                        <Button Content="Set up" Style="{StaticResource Ghost}" Click="GoObs_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="6,0">
                <StackPanel>
                    <TextBlock Text="Spotify" Style="{StaticResource H2}"/>
                    <TextBlock x:Name="SpotStatus" Style="{StaticResource Muted}" Margin="0,6,0,12" Text="Not linked"/>
                    <Button Content="Set up Spotify" Click="GoSpotify_Click" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="Clear" Style="{StaticResource Ghost}" Click="ClearFeed_Click"/>
                        <TextBlock Text="Live feed" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ListBox x:Name="FeedList" ItemContainerStyle="{StaticResource FeedItem}" FontFamily="Consolas" FontSize="12.5"/>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Send a test event" Style="{StaticResource H2}"/>
                        <TextBlock Text="Fires your events exactly as a real viewer would, without going LIVE." Style="{StaticResource Muted}" Margin="0,4,0,14"/>

                        <TextBlock Text="Viewer name" Style="{StaticResource Label}"/>
                        <TextBox x:Name="TestUser" Text="Test Viewer" Margin="0,0,0,12"/>

                        <TextBlock Text="Gift" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="TestGift" ItemTemplate="{StaticResource GiftItem}" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Count" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="TestCount" Text="1" Width="60"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Send gift" Style="{StaticResource Primary}" Click="TestGift_Click"/>
                        </Grid>

                        <WrapPanel Margin="0,0,0,10">
                            <Button Content="Follow" Click="TestFollow_Click" Margin="0,0,8,8"/>
                            <Button Content="Share" Click="TestShare_Click" Margin="0,0,8,8"/>
                            <Button Content="Subscribe" Click="TestSub_Click" Margin="0,0,8,8"/>
                            <Button Content="Join" Click="TestJoin_Click" Margin="0,0,8,8"/>
                        </WrapPanel>

                        <TextBlock Text="Likes" Style="{StaticResource Label}"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TestLikes" Text="100" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="Send likes" Click="TestLikes_Click"/>
                        </Grid>

                        <TextBlock Text="Chat message" Style="{StaticResource Label}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TestChat" Text="!sr never gonna give you up" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="Send chat" Click="TestChat_Click"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
