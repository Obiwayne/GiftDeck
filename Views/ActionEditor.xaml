<UserControl x:Class="GiftDeck.Views.ActionEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GiftDeck.Views"
             Loaded="OnLoaded">
    <Border Style="{StaticResource SubCard}">
        <StackPanel>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="TypeCombo" DisplayMemberPath="Label" SelectionChanged="TypeCombo_Changed"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button MinHeight="0" Content="▲" Style="{StaticResource Ghost}" Click="Up_Click" Padding="8,4" ToolTip="Move up"/>
                    <Button MinHeight="0" Content="▼" Style="{StaticResource Ghost}" Click="Down_Click" Padding="8,4" ToolTip="Move down"/>
                    <Button MinHeight="0" Content="✕" Style="{StaticResource Ghost}" Foreground="{StaticResource DangerBrush}" Click="Remove_Click" Padding="8,4" ToolTip="Remove this action"/>
                </StackPanel>
            </Grid>

            <Grid x:Name="KeyPanel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Click the box, then press the shortcut (for example Ctrl+Shift+Z)" Style="{StaticResource Label}"/>
                    <TextBox x:Name="KeyBox" IsReadOnly="True" PreviewKeyDown="KeyBox_KeyDown" FontFamily="Consolas" FontWeight="Bold" Cursor="Hand" local:Placeholder.Text="Click here, then press the keys"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Clear" Style="{StaticResource Ghost}" Click="ClearKey_Click" VerticalAlignment="Bottom" Margin="8,0,0,0"/>
                <StackPanel Grid.Column="2" Margin="12,0,0,0">
                    <TextBlock Text="Hold ms (0 = default)" Style="{StaticResource Label}"/>
                    <TextBox x:Name="HoldBox" Width="110" TextChanged="Field_Changed"/>
                </StackPanel>
            </Grid>

            <Grid x:Name="SoundPanel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Sound file (mp3 or wav)" Style="{StaticResource Label}"/>
                    <TextBox x:Name="SoundPath" TextChanged="Field_Changed"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="8,0,0,0">
                    <Button Content="Library" Style="{StaticResource Primary}" Click="LibrarySound_Click" Margin="0,0,6,0" ToolTip="Search the MyInstants sound library"/>
                    <Button Content="Browse" Click="BrowseSound_Click" ToolTip="Pick a file from this PC"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="12,0,0,0">
                    <TextBlock Text="Volume %" Style="{StaticResource Label}"/>
                    <TextBox x:Name="SoundVol" Width="70" TextChanged="Field_Changed"/>
                </StackPanel>
                <Button Grid.Column="3" Content="Play" Style="{StaticResource Ghost}" Click="PlaySound_Click" VerticalAlignment="Bottom" Margin="4,0,0,0"/>
            </Grid>

            <Grid x:Name="ScenePanel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Scene to switch to" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="SceneCombo" IsEditable="True"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Refresh scenes" Style="{StaticResource Ghost}" Click="RefreshScenes_Click" VerticalAlignment="Bottom" Margin="8,0,0,0"/>
            </Grid>

            <Grid x:Name="CanvasPanel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="Canvas" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="CanvasCombo" IsEditable="True"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Scene on that canvas" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="CanvasSceneCombo" IsEditable="True"/>
                </StackPanel>
                <Button Grid.Column="2" Content="Refresh" Style="{StaticResource Ghost}" Click="RefreshScenes_Click" VerticalAlignment="Bottom" Margin="8,0,0,0"/>
            </Grid>

            <Grid x:Name="SourcePanel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="Source name (exactly as in OBS)" Style="{StaticResource Label}"/>
                    <TextBox x:Name="SourceBox" TextChanged="Field_Changed" local:Placeholder.Text="For example: Alert overlay"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="In scene (blank = whatever scene is live)" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="SourceSceneCombo" IsEditable="True"/>
                </StackPanel>
            </Grid>

            <StackPanel x:Name="DelayPanel" Orientation="Horizontal">
                <TextBlock Text="Wait for" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="DelayBox" Width="100" TextChanged="Field_Changed"/>
                <TextBlock Text="milliseconds before the next action (1000 = 1 second)" VerticalAlignment="Center" Margin="8,0,0,0" Style="{StaticResource Muted}"/>
            </StackPanel>

            <StackPanel x:Name="TtsPanel">
                <TextBlock Text="Text to say" Style="{StaticResource Label}"/>
                <TextBox x:Name="TtsBox" TextChanged="Field_Changed"/>
                <TextBlock Text="{}You can use {user}, {gift}, {coins}, {count}, {likes} and {comment}." Style="{StaticResource Muted}" Margin="0,5,0,0"/>
            </StackPanel>

            <StackPanel x:Name="SpotifyRequestPanel">
                <TextBlock Text="Song to queue" Style="{StaticResource Label}"/>
                <TextBox x:Name="SpotifyQueryBox" TextChanged="Field_Changed"/>
                <TextBlock Text="{}{request} means the text after the chat command, so a viewer typing !sr daft punk queues Daft Punk. Or type a fixed song name here." Style="{StaticResource Muted}" Margin="0,5,0,0"/>
            </StackPanel>

            <Grid x:Name="SpotifyControlPanel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="What to do" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="SpotifyCmdCombo" DisplayMemberPath="Label" SelectionChanged="SpotifyCmd_Changed"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock x:Name="SpotifyNumLabel" Text="Amount" Style="{StaticResource Label}"/>
                    <TextBox x:Name="SpotifyNumBox" Width="90" TextChanged="Field_Changed"/>
                </StackPanel>
            </Grid>

            <Grid x:Name="ProgramPanel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Program or file to open" Style="{StaticResource Label}"/>
                    <TextBox x:Name="ProgramPath" TextChanged="Field_Changed"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Browse" Click="BrowseProgram_Click" VerticalAlignment="Bottom" Margin="8,0,8,0"/>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Arguments (optional)" Style="{StaticResource Label}"/>
                    <TextBox x:Name="ProgramArgs" TextChanged="Field_Changed"/>
                </StackPanel>
            </Grid>

            <!-- Run a game command: game, then a searchable list (500+ commands), then the command's own fields. -->
            <StackPanel x:Name="GamePanel">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Game" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="GameCombo" DisplayMemberPath="Label" SelectionChanged="GameCombo_Changed"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" x:Name="GameStatus" Style="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Bottom" Margin="12,0,0,6"/>
                </Grid>
                <TextBlock x:Name="NoGames" Style="{StaticResource Muted}" TextWrapping="Wrap"
                           Text="No games yet. Install a game on the Games page, or start a game with its GiftDeck mod, and its commands show up here."/>

                <StackPanel x:Name="CommandPicker">
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="CommandSearch" TextChanged="CommandSearch_Changed" Margin="0,0,8,0" local:Placeholder.Text="Search commands"/>
                        <ComboBox Grid.Column="1" x:Name="CategoryCombo" SelectionChanged="CategoryCombo_Changed"/>
                    </Grid>
                    <ListBox x:Name="CommandList" Height="200" ItemContainerStyle="{StaticResource FeedItem}"
                             SelectionChanged="CommandList_Changed"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.ScrollUnit="Pixel"
                             ScrollViewer.CanContentScroll="True">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" Margin="8,8,0,2"/>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="CommandCount" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>

                <DockPanel Margin="0,10,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button x:Name="GameTestButton" Content="Test" Style="{StaticResource Ghost}" Click="GameTest_Click"
                                ToolTip="Run this command in the game now (the game and its mod must be running)"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="ChosenCommand" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ChosenDescription" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="GameTestResult" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>
                <WrapPanel x:Name="GameArgsPanel" Margin="0,6,0,0"/>
                <TextBlock x:Name="GameArgsHint" Style="{StaticResource Muted}" Margin="0,4,0,0"
                           Text="{}Text fields can use {user}, {gift}, {coins}, {count}, {likes} and {comment}."/>
            </StackPanel>

            <StackPanel x:Name="StreamToolPanel">
                <TextBlock x:Name="StreamToolLabel" Text="Alert to show" Style="{StaticResource Label}"/>
                <ComboBox x:Name="StreamToolCombo" DisplayMemberPath="Label" SelectionChanged="StreamTool_Changed" Width="300" HorizontalAlignment="Left"/>
                <TextBlock x:Name="StreamToolHint" Style="{StaticResource Muted}" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
