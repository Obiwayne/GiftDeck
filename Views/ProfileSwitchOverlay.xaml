<UserControl x:Class="GiftDeck.Views.ProfileSwitchOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <!-- Shown while a profile loads: the logo's parcel and bolt animate separately. Covers the window so nothing is clicked mid-switch. -->
    <Grid x:Name="Root" Opacity="0">
        <Rectangle Fill="{StaticResource BgBrush}" Opacity="0.9"/>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Viewbox Width="150" Height="150">
                <Grid Width="100" Height="100">
                    <Rectangle RadiusX="23" RadiusY="23" Fill="#17191F" Stroke="#2A2F3D" StrokeThickness="0.8"/>

                    <!-- the parcel (bow, lid, box): spins -->
                    <Canvas x:Name="Parcel" Width="100" Height="100" RenderTransformOrigin="0.5,0.55">
                        <Canvas.RenderTransform>
                            <RotateTransform x:Name="ParcelSpin" Angle="0"/>
                        </Canvas.RenderTransform>
                        <Path Fill="#FF6B57" Data="M50,32 C42,12 19,10 20,23 C21,33 38,34 50,32 Z"/>
                        <Path Fill="#FF6B57" Data="M50,32 C58,12 81,10 80,23 C79,33 62,34 50,32 Z"/>
                        <Path Fill="#17191F" Data="M45.5,29.5 C41,21 30,18.5 29,23.5 C28.5,28 37,29.5 45.5,29.5 Z"/>
                        <Path Fill="#17191F" Data="M54.5,29.5 C59,21 70,18.5 71,23.5 C71.5,28 63,29.5 54.5,29.5 Z"/>
                        <Rectangle Canvas.Left="14" Canvas.Top="34" Width="72" Height="16" RadiusX="4.5" RadiusY="4.5" Fill="#FF6B57"/>
                        <Rectangle Canvas.Left="20" Canvas.Top="52.5" Width="60" Height="34" RadiusX="5" RadiusY="5" Fill="#F0503F"/>
                    </Canvas>

                    <!-- the lightning bolt: flies in, shoots off, slams back -->
                    <Canvas x:Name="BoltCanvas" Width="100" Height="100" RenderTransformOrigin="0.5,0.58" Opacity="0">
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="BoltScale" ScaleX="1" ScaleY="1"/>
                                <TranslateTransform x:Name="BoltMove" X="0" Y="0"/>
                            </TransformGroup>
                        </Canvas.RenderTransform>
                        <Path Fill="#FFC23D" Stroke="#17191F" StrokeThickness="4" StrokeLineJoin="Round"
                              Data="M59,25 L35,61 L48.5,61 L41,93 L67,51 L53.5,51 L63,25 Z"/>
                    </Canvas>
                </Grid>
            </Viewbox>
            <TextBlock x:Name="Caption" HorizontalAlignment="Center" FontSize="17" FontWeight="SemiBold" Margin="0,22,0,4"/>
            <TextBlock x:Name="SubCaption" HorizontalAlignment="Center" Style="{StaticResource Muted}" FontSize="13"/>
        </StackPanel>
    </Grid>
</UserControl>
