<UserControl x:Class="GiftDeck.Views.StreamToolsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GiftDeck.Views"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <StackPanel>
        <!-- One preview for the templates, spinners and alerts below: each Preview button shows its page here. -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Overlay templates" Style="{StaticResource H2}"/>
                    <TextBlock Text="Made from this profile's events and live totals, and they update as things change. Copy the URL into TikTok LIVE Studio (Add source, Link) or OBS (Browser Source)." Style="{StaticResource Muted}" Margin="0,3,0,12" TextWrapping="Wrap"/>

                    <Border Style="{StaticResource SubCard}" Margin="0,0,0,8">
                        <StackPanel>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button Content="Preview" Style="{StaticResource Ghost}" Click="PreviewGiftList_Click" Margin="0,0,6,0"/>
                                    <Button Content="Copy URL" Style="{StaticResource Small}" Click="CopyGiftList_Click" Margin="0,0,6,0"/>
                                    <Button Content="Add to OBS" Style="{StaticResource Small}" Click="ObsGiftList_Click"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Gift list" FontWeight="SemiBold" FontSize="15"/>
                                    <TextBlock Text="A tall list: gift picture, price and what it does, cheapest first. Browser Source 420 x 800." Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Header text" Style="{StaticResource Label}"/>
                                    <TextBox x:Name="GiftListTitle" Width="200" LostFocus="Templates_Changed"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Show at most (0 = all)" Style="{StaticResource Label}"/>
                                    <TextBox x:Name="GiftListMax" Width="90" LostFocus="Templates_Changed"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SubCard}">
                        <StackPanel>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button Content="Preview" Style="{StaticResource Ghost}" Click="PreviewStrip_Click" Margin="0,0,6,0"/>
                                    <Button Content="Copy URL" Style="{StaticResource Small}" Click="CopyStrip_Click" Margin="0,0,6,0"/>
                                    <Button Content="Add to OBS" Style="{StaticResource Small}" Click="ObsStrip_Click"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Top 3 gifters and next goal" FontWeight="SemiBold" FontSize="15"/>
                                    <TextBlock Text="A thin strip: this stream's three biggest gifters and the first goal not reached yet. Browser Source 900 x 90." Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="Label" Style="{StaticResource Label}"/>
                                <TextBox x:Name="StripTitle" Width="200" HorizontalAlignment="Left" LostFocus="Templates_Changed"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Grid.Column="1" Width="400" Background="#1A1D26" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" VerticalAlignment="Top">
                    <StackPanel>
                        <wv2:WebView2 x:Name="Preview" Height="300" DefaultBackgroundColor="#1A1D26"/>
                        <DockPanel Margin="8,4,8,6">
                            <Button MinHeight="0" DockPanel.Dock="Right" Content="Refresh" Style="{StaticResource Ghost}" Click="RefreshPreview_Click" Padding="8,3"/>
                            <TextBlock x:Name="PreviewLabel" Text="Preview" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Gift Spinner -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
                <DockPanel Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Content="+  Add spinner" Click="AddSpinner_Click" VerticalAlignment="Top"/>
                    <StackPanel>
                        <TextBlock Text="Gift Spinner" Style="{StaticResource H2}"/>
                        <TextBlock Text="A wheel on stream that picks one of your events. Put events on it by opening them and picking a rarity; rarer ones come up less often. An event with the 'Spin the Gift Spinner' action (for example a gift) spins it, and when it stops the event it landed on runs. Browser Source 600 x 700." Style="{StaticResource Muted}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
                <TextBlock x:Name="NoSpinners" Text="No spinners yet." Style="{StaticResource Muted}" Margin="0,8,0,0"/>
                <ItemsControl x:Name="SpinnersList" Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource SubCard}" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="Name" Style="{StaticResource Label}"/>
                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" LostFocus="Field_Changed"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                            <TextBlock Text="Spin seconds" Style="{StaticResource Label}"/>
                                            <TextBox Text="{Binding SpinSeconds, UpdateSourceTrigger=LostFocus}" LostFocus="Field_Changed"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="2" Content="Hide between spins" IsChecked="{Binding HideWhenIdle}" Click="Field_Changed" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                                    </Grid>

                                    <TextBlock Text="Events on this spinner" Style="{StaticResource Label}" Margin="0,12,0,4"/>
                                    <TextBlock Text="None yet. To add one, open an event on the Events page and pick a rarity under Gift Spinner." TextWrapping="Wrap" Margin="0,0,0,6">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasNoEvents}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding EventEntries}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="18"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="64"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="12" Height="22" CornerRadius="3" Background="{Binding EffectiveColor}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Rarity}" Foreground="{Binding EffectiveColor}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding ChanceText}" Style="{StaticResource Muted}" VerticalAlignment="Center" ToolTip="Chance of landing on this event"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding ActionsText}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="To add, change or remove one, open the event on the Events page (Gift Spinner). Events that are switched off are left off the wheel." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,4"/>

                                    <TextBlock Text="Other prizes (optional, with their own actions)" Style="{StaticResource Label}" Margin="0,12,0,4"/>
                                    <ItemsControl ItemsSource="{Binding Entries}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="18"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="64"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="12" Height="28" CornerRadius="3" Background="{Binding EffectiveColor}" VerticalAlignment="Center"/>
                                                    <TextBox Grid.Column="1" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" LostFocus="Field_Changed" Margin="0,0,6,0" ToolTip="What viewers see on the wheel"/>
                                                    <ComboBox Grid.Column="2" ItemsSource="{x:Static local:StreamToolsPanel.RarityList}" SelectedItem="{Binding Rarity}" SelectionChanged="Entry_Changed" Margin="0,0,6,0"/>
                                                    <TextBox Grid.Column="3" Text="{Binding Weight, UpdateSourceTrigger=LostFocus}" LostFocus="Entry_Changed" Margin="0,0,6,0" ToolTip="Weight: how often it comes up compared with the others. 0 = the tier's usual weight (Common 50, Uncommon 25, Rare 15, Epic 8, Legendary 2)."/>
                                                    <TextBox Grid.Column="4" Text="{Binding Color, UpdateSourceTrigger=LostFocus}" LostFocus="Field_Changed" FontFamily="Consolas" Margin="0,0,6,0" ToolTip="Colour on the wheel, like #FF4488. Blank = the tier's colour."/>
                                                    <TextBlock Grid.Column="5" Text="{Binding ChanceText}" Style="{StaticResource Muted}" VerticalAlignment="Center" ToolTip="Chance of landing on this prize"/>
                                                    <Button Grid.Column="6" Content="{Binding ActionsText}" Style="{StaticResource Small}" Tag="{Binding}" Click="EntryActions_Click" Margin="0,0,6,0" MinWidth="86"/>
                                                    <Button Grid.Column="7" MinHeight="0" Content="✕" Style="{StaticResource Ghost}" Foreground="{StaticResource DangerBrush}" Tag="{Binding}" Click="RemoveEntry_Click" Padding="8,4" ToolTip="Remove this prize"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="Columns: prize, tier, weight (0 = tier default), colour (blank = tier colour), chance." Style="{StaticResource Muted}" Margin="0,2,0,8"/>

                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="+  Add prize" Style="{StaticResource Small}" Tag="{Binding}" Click="AddEntry_Click" Margin="0,0,14,0"/>
                                        <Button Content="Spin now" Style="{StaticResource Primary}" Tag="{Binding}" Click="SpinNow_Click" Margin="0,0,8,0"/>
                                        <CheckBox Content="Also run what it lands on" IsChecked="{Binding TestRunsActions}" VerticalAlignment="Center" Margin="0,0,14,0" ToolTip="Off: the wheel spins on the overlay only, nothing is pressed or sent to a game."/>
                                        <Button Content="Preview" Style="{StaticResource Ghost}" Tag="{Binding}" Click="PreviewSpinner_Click" Margin="0,0,6,0"/>
                                        <Button Content="Copy URL" Style="{StaticResource Small}" Tag="{Binding}" Click="CopySpinner_Click" Margin="0,0,6,0"/>
                                        <Button Content="Add to OBS" Style="{StaticResource Small}" Tag="{Binding}" Click="ObsSpinner_Click" Margin="0,0,6,0"/>
                                        <Button Content="Remove" Style="{StaticResource SmallDanger}" Tag="{Binding}" Click="RemoveSpinner_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Alerts and interrupts -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
                <DockPanel Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Content="+  Add alert" Click="AddAlert_Click" VerticalAlignment="Top"/>
                    <StackPanel>
                        <TextBlock Text="Alerts and interrupts" Style="{StaticResource H2}"/>
                        <TextBlock Text="Your own alerts: a picture, GIF or video, a sound and a line of text, shown on the Gift alerts overlay by an event's 'Show an alert' action. An interrupt cuts in straight away and holds back every other event's actions until it has finished, then they carry on in order. For full-screen alerts make the Gift alerts Browser Source cover the whole screen." Style="{StaticResource Muted}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
                <TextBlock x:Name="NoAlerts" Text="No alerts yet." Style="{StaticResource Muted}" Margin="0,8,0,0"/>
                <ItemsControl x:Name="AlertsList" Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource SubCard}" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="Name" Style="{StaticResource Label}"/>
                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" LostFocus="Field_Changed"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                            <TextBlock Text="{}Text ({user}, {gift}, {count}, {coins})" Style="{StaticResource Label}"/>
                                            <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" LostFocus="Field_Changed"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Seconds" Style="{StaticResource Label}"/>
                                            <TextBox Text="{Binding Seconds, UpdateSourceTrigger=LostFocus}" LostFocus="Field_Changed"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="70"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,6,0">
                                            <TextBlock Text="Picture, GIF or video (WebM, MP4)" Style="{StaticResource Label}"/>
                                            <TextBox Text="{Binding Media, UpdateSourceTrigger=LostFocus}" LostFocus="Field_Changed"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Browse" Style="{StaticResource Small}" Tag="{Binding}" Click="AlertMedia_Click" VerticalAlignment="Bottom" Margin="0,0,12,0"/>
                                        <StackPanel Grid.Column="2" Margin="0,0,6,0">
                                            <TextBlock Text="Sound (mp3 or wav, played on this PC)" Style="{StaticResource Label}"/>
                                            <TextBox Text="{Binding Sound, UpdateSourceTrigger=LostFocus}" LostFocus="Field_Changed"/>
                                        </StackPanel>
                                        <Button Grid.Column="3" Content="Browse" Style="{StaticResource Small}" Tag="{Binding}" Click="AlertSound_Click" VerticalAlignment="Bottom" Margin="0,0,8,0"/>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Volume %" Style="{StaticResource Label}"/>
                                            <TextBox Text="{Binding Volume, UpdateSourceTrigger=LostFocus}" LostFocus="Field_Changed"/>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox Content="Interrupt: pause other events while it plays" IsChecked="{Binding Interrupt}" Click="Field_Changed" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                        <CheckBox Content="Full screen" IsChecked="{Binding FullScreen}" Click="Field_Changed" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                        <Button Content="Test" Style="{StaticResource Primary}" Tag="{Binding}" Click="TestAlert_Click" Margin="0,0,6,0" ToolTip="Shows it on the alerts overlay (and here) without pausing anything"/>
                                        <Button Content="Remove" Style="{StaticResource SmallDanger}" Tag="{Binding}" Click="RemoveAlert_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
        <TextBlock x:Name="Status" Style="{StaticResource Muted}" Margin="0,0,0,14"/>
    </StackPanel>
</UserControl>
