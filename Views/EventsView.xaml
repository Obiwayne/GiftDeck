<UserControl x:Class="GiftDeck.Views.EventsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32,28,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,18">
            <Button DockPanel.Dock="Right" Content="+  New event" Style="{StaticResource Primary}" Click="New_Click" VerticalAlignment="Top"/>
            <StackPanel>
                <TextBlock Text="Events" Style="{StaticResource H1}"/>
                <TextBlock Text="When something happens on your LIVE, GiftDeck does what you set here. Add as many as you like." Style="{StaticResource Muted}" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock x:Name="CountText" DockPanel.Dock="Right" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0"/>
            <TextBlock x:Name="TestStatus" DockPanel.Dock="Right" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0"/>
            <TextBox x:Name="SearchBox" Width="300" HorizontalAlignment="Left" TextChanged="Search_Changed"
                     ToolTip="Filter by name, gift, trigger or action"/>
        </DockPanel>

        <TextBlock x:Name="Empty" Grid.Row="2" Text="No events yet. Click New event to add your first one." Style="{StaticResource Muted}"
                   HorizontalAlignment="Center" Margin="0,60,0,0" Visibility="Collapsed"/>

        <ListBox x:Name="RuleList" Grid.Row="2" MouseDoubleClick="RuleList_DoubleClick" KeyDown="RuleList_KeyDown">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" Click="Enabled_Click" VerticalAlignment="Center" Margin="0,0,16,0" ToolTip="Enabled"/>
                            <Border Grid.Column="1" Width="40" Height="40" Margin="0,0,14,0" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TriggerGift}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Image Source="{Binding TriggerGift.Image}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <!-- On a Gift Spinner: its rarity, in the tier's colour -->
                                    <Border CornerRadius="8" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center" BorderThickness="1"
                                            BorderBrush="{Binding SpinBadgeColor}" ToolTip="On the Gift Spinner at this rarity">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SpinBadge}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding SpinBadge, StringFormat='Spinner: {0}'}" Foreground="{Binding SpinBadgeColor}" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding TriggerSummary}" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding ActionsSummary}" Margin="0,3,0,0" FontSize="12"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                <Button Content="Test" Style="{StaticResource Small}" Tag="{Binding}" Click="Test_Click" Margin="4,0"/>
                                <Button Content="Edit" Style="{StaticResource Small}" Tag="{Binding}" Click="Edit_Click" Margin="4,0"/>
                                <Button Content="Duplicate" Style="{StaticResource Small}" Tag="{Binding}" Click="Duplicate_Click" Margin="4,0"/>
                                <Button Content="Delete" Style="{StaticResource SmallDanger}" Tag="{Binding}" Click="Delete_Click" Margin="4,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
