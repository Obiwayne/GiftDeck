<UserControl x:Class="GiftDeck.Views.AllInOnePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GiftDeck.Views"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <!-- The all-in-one overlay: one link that shows alerts, the Gift Spinner, goals, top gifters and more. -->
    <Border Style="{StaticResource Card}" Margin="0,0,0,14" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="All-in-one overlay" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                    <Border Background="{StaticResource AccentDimBrush}" CornerRadius="9" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Recommended" FontSize="11" FontWeight="SemiBold" Foreground="#C9BCFF"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="One link for everything. Add it once in TikTok LIVE Studio (Add source, Link) or OBS (Browser Source), then switch the parts on and off here. Alerts, the Gift Spinner, goals and top gifters all show on it, and it updates live."
                           Style="{StaticResource Muted}" Margin="0,3,0,10" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="Copy URL" Style="{StaticResource Primary}" Click="Copy_Click" Margin="0,0,6,0"/>
                    <Button Content="Add to OBS" Style="{StaticResource Small}" Click="Obs_Click" Margin="0,0,6,0"/>
                    <Button Content="Test alert" Style="{StaticResource Ghost}" Click="TestAlert_Click" Margin="0,0,6,0" ToolTip="Shows a made-up gift alert on the overlay"/>
                    <Button x:Name="SpinButton" Content="Test spin" Style="{StaticResource Ghost}" Click="TestSpin_Click" ToolTip="Spins your first Gift Spinner on the overlay. Its prize's actions are not run."/>
                </StackPanel>

                <!-- One row per part: on/off, where it sits, how wide it is -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Show" Style="{StaticResource Label}"/>
                    <TextBlock Grid.Column="1" Text="Where" Style="{StaticResource Label}"/>
                    <TextBlock Grid.Column="2" Text="Width %" Style="{StaticResource Label}"/>
                </Grid>
                <ItemsControl x:Name="Parts">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding Part.On}" Click="Changed" VerticalAlignment="Center" ToolTip="{Binding Hint}">
                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
                                </CheckBox>
                                <ComboBox Grid.Column="1" ItemsSource="{x:Static local:AllInOnePanel.SpotList}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding Part.Spot}" SelectionChanged="Changed" Margin="0,0,8,0" IsEnabled="{Binding Part.On}"/>
                                <TextBox Grid.Column="2" Text="{Binding Part.Width, UpdateSourceTrigger=LostFocus}" LostFocus="Changed"
                                         Visibility="{Binding WidthVisibility}" IsEnabled="{Binding Part.On}" ToolTip="How wide it is, in % of the overlay's width"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <CheckBox x:Name="SpinnerIdle" Content="Only show the Gift Spinner while it spins" Click="Changed" Margin="0,4,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Shape" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="Shape" Width="200" SelectionChanged="Shape_Changed">
                            <ComboBoxItem Content="Portrait 1080 x 1920"/>
                            <ComboBoxItem Content="Landscape 1920 x 1080"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="ScaleLabel" Text="Size" Style="{StaticResource Label}"/>
                        <Slider x:Name="ScaleSlider" Minimum="50" Maximum="300" SmallChange="10" LargeChange="25" IsSnapToTickEnabled="True" TickFrequency="10"
                                ValueChanged="Scale_Changed" Width="280" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
                <CheckBox x:Name="Room" Content="Leave room for TikTok's buttons and chat (top and bottom, portrait only)" Click="Changed" Margin="0,10,0,0"/>
                <TextBlock Text="Full-screen alerts always cover the whole overlay. For the alert videos' sound in OBS, tick 'Control audio via OBS' on the Browser Source (Add to OBS does it for you)."
                           Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                <TextBlock x:Name="Status" Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <Border Grid.Column="1" Background="#1A1D26" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" VerticalAlignment="Top">
                <StackPanel>
                    <wv2:WebView2 x:Name="Preview" Width="270" Height="480" DefaultBackgroundColor="#1A1D26"/>
                    <DockPanel Margin="8,4,8,6">
                        <Button MinHeight="0" DockPanel.Dock="Right" Content="Refresh" Style="{StaticResource Ghost}" Click="Refresh_Click" Padding="8,3"/>
                        <TextBlock x:Name="PreviewLabel" Text="Preview" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
