<UserControl x:Class="GiftDeck.Views.LivePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,16,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Viewer count for the LIVE -->
        <Border Grid.ColumnSpan="2" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock x:Name="PeakText" Text="Peak 0" Style="{StaticResource Muted}" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="TotalText" Text="" Style="{StaticResource Muted}" HorizontalAlignment="Right"/>
                </StackPanel>
                <Ellipse x:Name="LiveDot" Width="10" Height="10" Fill="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock x:Name="ViewerText" Text="0" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Text="watching now" Style="{StaticResource Muted}" FontSize="14" VerticalAlignment="Center" Margin="10,6,0,0"/>
            </DockPanel>
        </Border>

        <!-- Live chat: oldest at the top, newest at the bottom, like TikTok -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,0,12,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right" Content="Clear" Style="{StaticResource Ghost}" Padding="6,3" Click="ClearChat_Click"/>
                    <TextBlock Text="Live chat" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                </DockPanel>
                <Grid>
                    <TextBlock x:Name="ChatEmpty" Text="Chat messages from your LIVE will show up here." Style="{StaticResource Muted}" Margin="4"/>
                    <ListBox x:Name="ChatList" ItemContainerStyle="{StaticResource FeedItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="14" Background="{Binding Colour}" VerticalAlignment="Top" Margin="0,1,9,0">
                                        <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="SemiBold" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" Style="{StaticResource Muted}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}" Foreground="{Binding Colour}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Message}" FontSize="13"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Gifts: newest at the top, with a running total -->
        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Padding="14">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,2">
                    <Button DockPanel.Dock="Right" Content="Clear" Style="{StaticResource Ghost}" Padding="6,3" Click="ClearGifts_Click"/>
                    <TextBlock Text="Gifts" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock x:Name="GiftTotals" DockPanel.Dock="Top" Text="0 gifts · 0 coins" Style="{StaticResource Muted}" Margin="0,0,0,10"/>
                <Grid>
                    <TextBlock x:Name="GiftEmpty" Text="Gifts people send will show up here, newest first." Style="{StaticResource Muted}" Margin="4"/>
                    <ListBox x:Name="GiftList" ItemContainerStyle="{StaticResource FeedItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,3">
                                    <Grid DockPanel.Dock="Left" Width="36" Height="36" Margin="0,0,10,0" VerticalAlignment="Top">
                                        <Border CornerRadius="8" Background="{StaticResource Panel2Brush}"/>
                                        <Image Source="{Binding Gift.Image}" Margin="3" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" Style="{StaticResource Muted}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                        </DockPanel>
                                        <TextBlock FontSize="12.5">
                                            <Run Text="{Binding GiftText, Mode=OneWay}"/>
                                            <Run Text="{Binding CoinText, Mode=OneWay}" Foreground="{StaticResource WarnBrush}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
