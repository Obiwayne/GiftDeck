<UserControl x:Class="GiftDeck.Views.LivePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GiftDeck.Views">
    <!-- The right-hand side panel: mirrors the menu on the left (full height, one background, flush to the edge). -->
    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Header strip, same height as the PROFILE bar so the top edge lines up across the window -->
            <Border Grid.ColumnSpan="3" Height="58" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="20,0">
                <DockPanel VerticalAlignment="Center">
                    <TextBlock x:Name="PeakText" DockPanel.Dock="Right" Text="Peak 0" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TotalText" DockPanel.Dock="Right" Text="" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Ellipse x:Name="LiveDot" Width="10" Height="10" Fill="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="ViewerText" Text="0" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="watching now" Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" Margin="8,3,0,0"/>
                </DockPanel>
            </Border>

            <!-- Start-up status: what's still loading (OBS, TikFinity/the bridge) or what went wrong. Hides once all is ready. -->
            <Border x:Name="StatusStrip" Grid.Row="1" Grid.ColumnSpan="3" Background="{StaticResource BgBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="20,10" Visibility="Collapsed">
                <StackPanel x:Name="StatusRows"/>
            </Border>

            <!-- Live chat: oldest at the top, newest at the bottom, like TikTok -->
            <DockPanel Grid.Row="2">
                <DockPanel DockPanel.Dock="Top" Margin="20,14,12,8">
                    <Button MinHeight="0" DockPanel.Dock="Right" Content="Clear" Style="{StaticResource Ghost}" Padding="8,2" FontSize="12" Click="ClearChat_Click"/>
                    <TextBlock Text="LIVE CHAT" Style="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>
                <Grid Margin="12,0,6,12">
                    <TextBlock x:Name="ChatEmpty" Text="Chat messages from your LIVE will show up here." Style="{StaticResource Muted}" Margin="8,4"/>
                    <ListBox x:Name="ChatList" ItemContainerStyle="{StaticResource FeedItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="14" Background="{Binding Colour}" VerticalAlignment="Top" Margin="0,1,9,0">
                                        <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="SemiBold" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" Style="{StaticResource Muted}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}" Foreground="{Binding Colour}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Message}" FontSize="13"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </DockPanel>

            <Border Grid.Row="2" Grid.Column="1" Background="{StaticResource LineBrush}"/>

            <!-- Gifts: newest at the top, with a running total -->
            <DockPanel Grid.Row="2" Grid.Column="2">
                <DockPanel DockPanel.Dock="Top" Margin="20,14,12,8">
                    <Button MinHeight="0" DockPanel.Dock="Right" Content="Clear" Style="{StaticResource Ghost}" Padding="8,2" FontSize="12" Click="ClearGifts_Click"/>
                    <TextBlock Text="GIFTS" Style="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="GiftTotals" Text="0 gifts · 0 coins" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </DockPanel>
                <Grid Margin="12,0,6,12">
                    <TextBlock x:Name="GiftEmpty" Text="Gifts people send will show up here, newest first." Style="{StaticResource Muted}" Margin="8,4"/>
                    <ListBox x:Name="GiftList" ItemContainerStyle="{StaticResource FeedItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,3">
                                    <Grid DockPanel.Dock="Left" Width="36" Height="36" Margin="0,0,10,0" VerticalAlignment="Top">
                                        <Border CornerRadius="8" Background="{StaticResource Panel2Brush}"/>
                                        <Image Source="{Binding Gift.Image}" Margin="3" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" Style="{StaticResource Muted}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                        </DockPanel>
                                        <TextBlock FontSize="12.5">
                                            <Run Text="{Binding GiftText, Mode=OneWay}"/>
                                            <Run Text="{Binding CoinText, Mode=OneWay}" Foreground="{StaticResource WarnBrush}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
