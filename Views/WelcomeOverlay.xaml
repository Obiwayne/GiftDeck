<UserControl x:Class="GiftDeck.Views.WelcomeOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" FocusVisualStyle="{x:Null}"
             PreviewKeyDown="Overlay_PreviewKeyDown" KeyDown="Overlay_KeyDown">
    <!-- The first thing a new (or upgrading) user sees: three short pages about MayhemDeck, before the setup steps.
         Settings can show it again. Pages are switched in code (WelcomeOverlay.xaml.cs). -->
    <UserControl.Resources>
        <!-- Round icon badge: accent glyph on a dim accent circle -->
        <Style x:Key="IconBadge" TargetType="Border">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Background" Value="{StaticResource AccentDimBrush}"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="IconGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="#A995FF"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FeatureTitle" TargetType="TextBlock" BasedOn="{StaticResource H2}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,1,0,3"/>
        </Style>
        <Style x:Key="FeatureText" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="LineHeight" Value="18"/>
        </Style>
        <!-- "No ..." rows on the free page -->
        <Style x:Key="Tick" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="Text" Value="&#xE73E;"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,3,14,0"/>
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource H1}">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PageLead" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="LineHeight" Value="23"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="MaxWidth" Value="520"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root" Background="{StaticResource BgBrush}">
        <!-- A soft glow behind the card -->
        <Ellipse Width="900" Height="620" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#267C5CFF" Offset="0"/>
                    <GradientStop Color="#0A7C5CFF" Offset="0.55"/>
                    <GradientStop Color="#007C5CFF" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <Border x:Name="CardBox" Style="{StaticResource Card}" MaxWidth="720" Margin="40,28" Padding="0"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="CardScale"/>
                        <TranslateTransform x:Name="CardShift"/>
                    </TransformGroup>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="10" Direction="270" Opacity="0.45" Color="Black"/>
                </Border.Effect>
                <DockPanel>
                    <!-- Footer: skip, page dots, back / next -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="SkipButton" Content="Skip" Style="{StaticResource Ghost}" FontSize="12" MinHeight="30" Padding="10,0" Opacity="0.7"
                                    HorizontalAlignment="Left" Click="Skip_Click" ToolTip="Skip the welcome (Esc)"/>
                            <StackPanel x:Name="Dots" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="BackButton" Content="Back" Style="{StaticResource Ghost}" Margin="0,0,8,0" Click="Back_Click"/>
                                <Button x:Name="NextButton" Content="Next" Style="{StaticResource Primary}" MinWidth="96" Click="Next_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid x:Name="Pages" Margin="44,36,44,30" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="PageShift"/>
                        </Grid.RenderTransform>

                        <!-- Page 1: what it is -->
                        <StackPanel x:Name="Page1" VerticalAlignment="Center">
                            <Image Source="{StaticResource LogoImage}" Width="76" Height="76" HorizontalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,0,18"/>
                            <TextBlock Text="Welcome to MayhemDeck" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Your viewers' gifts, likes and chat set off chaos in your games and on your stream." Style="{StaticResource PageLead}" MaxWidth="600"/>

                            <Border x:Name="RenameNote" Background="{StaticResource AccentDimBrush}" CornerRadius="8" Padding="14,10"
                                    Margin="0,18,0,0" HorizontalAlignment="Center" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE946;" FontSize="15" Foreground="#A995FF"
                                               VerticalAlignment="Top" Margin="0,2,10,0"/>
                                    <TextBlock FontSize="13" LineHeight="19" MaxWidth="500">
                                        <Run Text="GiftDeck is now MayhemDeck" FontWeight="SemiBold"/><Run Text=" — same app, new name. Your settings and events are all still here."/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,26,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="14"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Style="{StaticResource SubCard}" Padding="14">
                                    <DockPanel>
                                        <Border Style="{StaticResource IconBadge}" Margin="0,0,12,0">
                                            <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE7FC;"/>
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="Chaos in your games" Style="{StaticResource FeatureTitle}"/>
                                            <TextBlock Text="GTA V, Minecraft and 50+ more react to your LIVE." Style="{StaticResource FeatureText}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource SubCard}" Padding="14">
                                    <DockPanel>
                                        <Border Style="{StaticResource IconBadge}" Margin="0,0,12,0">
                                            <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE7F4;"/>
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="Alerts and overlays" Style="{StaticResource FeatureTitle}"/>
                                            <TextBlock Text="Gift alerts, goals and on-screen menus for your viewers." Style="{StaticResource FeatureText}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border Grid.Row="2" Style="{StaticResource SubCard}" Padding="14">
                                    <DockPanel>
                                        <Border Style="{StaticResource IconBadge}" Margin="0,0,12,0">
                                            <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE714;"/>
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="OBS scenes and Go LIVE" Style="{StaticResource FeatureTitle}"/>
                                            <TextBlock Text="Start your LIVE and switch scenes from one place." Style="{StaticResource FeatureText}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource SubCard}" Padding="14">
                                    <DockPanel>
                                        <Border Style="{StaticResource IconBadge}" Margin="0,0,12,0">
                                            <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE767;"/>
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="Text to speech and music" Style="{StaticResource FeatureTitle}"/>
                                            <TextBlock Text="Read chat out loud, play sounds and take song requests." Style="{StaticResource FeatureText}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <!-- Page 2: it's free -->
                        <StackPanel x:Name="Page2" VerticalAlignment="Center" Visibility="Collapsed">
                            <Border Width="76" Height="76" CornerRadius="38" Background="{StaticResource AccentDimBrush}" HorizontalAlignment="Center" Margin="0,0,0,18">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xEB51;" FontSize="34" Foreground="#A995FF"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="It's free. Really." Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="MayhemDeck doesn't cost anything, and it isn't a trial." Style="{StaticResource PageLead}"/>

                            <Border Style="{StaticResource SubCard}" Padding="22,18" Margin="0,26,0,0" MaxWidth="500">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,14">
                                        <TextBlock Style="{StaticResource Tick}"/>
                                        <StackPanel>
                                            <TextBlock Text="No account" Style="{StaticResource FeatureTitle}"/>
                                            <TextBlock Text="Nothing to sign up for. Open it and go." Style="{StaticResource FeatureText}"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,14">
                                        <TextBlock Style="{StaticResource Tick}"/>
                                        <StackPanel>
                                            <TextBlock Text="No subscription, no limits, no watermark" Style="{StaticResource FeatureTitle}"/>
                                            <TextBlock Text="Every game, alert and feature is there for everyone." Style="{StaticResource FeatureText}"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <DockPanel>
                                        <TextBlock Style="{StaticResource Tick}"/>
                                        <StackPanel>
                                            <TextBlock Text="Your settings stay on your PC" Style="{StaticResource FeatureTitle}"/>
                                            <TextBlock Text="Your events, sounds and layouts are saved on this computer, not in someone's cloud." Style="{StaticResource FeatureText}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource Muted}" FontSize="13" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,20,0,0"
                                       Text="Built by one creator, in their spare time."/>
                        </StackPanel>

                        <!-- Page 3: say thanks -->
                        <StackPanel x:Name="Page3" VerticalAlignment="Center" Visibility="Collapsed">
                            <Border Width="76" Height="76" CornerRadius="38" Background="{StaticResource AccentDimBrush}" HorizontalAlignment="Center" Margin="0,0,0,18">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xEB52;" FontSize="34" Foreground="#FF6B8B"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Say thanks" Style="{StaticResource PageTitle}"/>
                            <TextBlock Style="{StaticResource PageLead}" MaxWidth="500"
                                       Text="Thanks for giving MayhemDeck a go. If it makes your LIVEs more fun, a follow on TikTok is the best way to say thanks, and it's where new games and features show up first."/>

                            <Button x:Name="FollowButton" Style="{StaticResource Primary}" HorizontalAlignment="Center" Margin="0,28,0,0"
                                    MinHeight="50" Padding="26,0" FontSize="15" Click="Follow_Click" ToolTip="https://www.tiktok.com/@obiwayn3">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FF3B6F" Offset="0"/>
                                        <GradientStop Color="#7C5CFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Button.Background>
                                <Button.BorderBrush>
                                    <SolidColorBrush Color="Transparent"/>
                                </Button.BorderBrush>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8FA;" FontSize="17" Foreground="White"
                                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Foreground="White" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="NoWrap">
                                        <Run Text="Follow"/> <Run Text="@obiwayn3" FontWeight="Bold"/> <Run Text="on TikTok"/>
                                    </TextBlock>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource Ghost}" HorizontalAlignment="Center" Margin="0,10,0,0" MinHeight="32" Padding="12,0"
                                    Click="GitHub_Click" ToolTip="https://github.com/Obiwayne/MayhemDeck">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE734;" FontSize="13" Foreground="{StaticResource WarnBrush}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Or star it on GitHub" Foreground="{StaticResource MutedBrush}" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
