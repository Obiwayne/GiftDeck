<Window x:Class="GiftDeck.Views.StarterScenesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add starter scenes" WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        Background="#B8080910" ShowInTaskbar="False" FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <!-- Covers the app (darkening it) with the picker in the middle. A click on the dark part cancels. -->
    <Grid x:Name="Backdrop" MouseLeftButtonDown="Backdrop_MouseDown">
        <Border x:Name="Card" Style="{StaticResource Card}" Padding="0" MaxWidth="660" Margin="24"
                HorizontalAlignment="Center" VerticalAlignment="Center" MouseLeftButtonDown="Card_MouseDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.6"/>
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="CardShift"/>
            </Border.RenderTransform>
            <DockPanel>
                <!-- Buttons -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="22,14">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Cancel" Style="{StaticResource Ghost}" Click="Cancel_Click" Margin="0,0,8,0" IsCancel="True"/>
                            <Button x:Name="CreateButton" Content="Create scenes" Style="{StaticResource Primary}" Click="Create_Click" MinWidth="150" IsDefault="True"/>
                        </StackPanel>
                        <CheckBox x:Name="SelectAll" Content="Select all" VerticalAlignment="Center" Click="SelectAll_Click"/>
                    </DockPanel>
                </Border>

                <StackPanel Margin="22,20,22,12">
                    <TextBlock Text="Add starter scenes" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,16"
                               Text="Pick the scenes you want. Each comes with your webcam, screen and MayhemDeck overlay already in place, and your own scenes aren't changed."/>
                    <ScrollViewer x:Name="SceneList" VerticalScrollBarVisibility="Auto" MaxHeight="440">
                        <StackPanel x:Name="Rows"/>
                    </ScrollViewer>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
