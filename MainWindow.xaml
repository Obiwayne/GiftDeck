<Window x:Class="GiftDeck.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GiftDeck.Views"
        Title="GiftDeck" Width="1880" Height="980" MinWidth="1320" MinHeight="620"
        Background="{StaticResource BgBrush}" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SideColumn" Width="228"/>
            <ColumnDefinition Width="*" MinWidth="640"/>
            <ColumnDefinition x:Name="LiveColumn" Width="620" MinWidth="420"/>
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel x:Name="Header" DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,22,20,22">
                    <Image Source="{StaticResource LogoImage}" Width="38" Height="38" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel x:Name="HeaderText" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="GiftDeck" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="LIVE event control" Style="{StaticResource Muted}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="Footer" DockPanel.Dock="Bottom" Margin="20,0,20,20">
                    <Button x:Name="CollapseButton" Style="{StaticResource Ghost}" HorizontalAlignment="Left" Padding="4,8" Margin="0,0,0,14" Click="Collapse_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="CollapseGlyph" FontFamily="{StaticResource IconFont}" Text="&#xE76B;" FontSize="14" Width="20" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock x:Name="CollapseLabel" Text="Collapse menu" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="ConnectionsLabel" Text="CONNECTIONS" Style="{StaticResource Muted}" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,3">
                        <Ellipse x:Name="TikDot" Width="9" Height="9" Margin="0,0,9,0" Fill="{StaticResource MutedBrush}"/>
                        <TextBlock x:Name="TikText" Text="TikFinity" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3">
                        <Ellipse x:Name="ObsDot" Width="9" Height="9" Margin="0,0,9,0" Fill="{StaticResource MutedBrush}"/>
                        <TextBlock x:Name="ObsText" Text="OBS" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3">
                        <Ellipse x:Name="SpotDot" Width="9" Height="9" Margin="0,0,9,0" Fill="{StaticResource MutedBrush}"/>
                        <TextBlock x:Name="SpotText" Text="Spotify" FontSize="12"/>
                    </StackPanel>
                </StackPanel>

                <!-- Filled from MainWindow.NavItems (grouped under section headings); scrolls on short windows -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="NavPanel" Margin="12,0"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Own adorner layers, so placeholder hints stay under the overlays below -->
        <AdornerDecorator Grid.Column="1">
        <DockPanel>
            <!-- Profile bar: always shows which profile is in use, and switches it from any page -->
            <Border DockPanel.Dock="Top" Height="58" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="32,0">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Padding="10,5" Click="ManageProfiles_Click" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE713;" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock Text="Manage profiles" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8F1;" FontSize="16" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
                        <TextBlock Text="PROFILE" Style="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox x:Name="ProfileBox" Width="260" FontSize="14" FontWeight="SemiBold" SelectionChanged="ProfileBox_Changed" DropDownOpened="ProfileBox_Opened"
                                  ToolTip="Switch profile: loads that profile's events, board pictures, overlays, title and category"/>
                        <TextBlock x:Name="ProfileNote" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <ContentControl x:Name="ContentHost"/>
        </DockPanel>
        </AdornerDecorator>

        <AdornerDecorator x:Name="LiveHost" Grid.Column="2">
            <views:LivePanel/>
        </AdornerDecorator>
        <views:ProfileSwitchOverlay x:Name="SwitchOverlay" Grid.ColumnSpan="3" Panel.ZIndex="100"/>

        <!-- The screen GiftDeck opens on: setup steps if anything is missing, then the ready check. -->
        <views:SetupWizard x:Name="Setup" Grid.ColumnSpan="3" Panel.ZIndex="150" Visibility="Collapsed"/>

        <!-- Shown after the close button: GiftDeck stays on screen until OBS and everything else has shut down. -->
        <Grid x:Name="ShutdownOverlay" Grid.ColumnSpan="3" Panel.ZIndex="200" Visibility="Collapsed">
            <Rectangle Fill="{StaticResource BgBrush}" Opacity="0.94"/>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse Width="44" Height="44" StrokeThickness="4" Stroke="{StaticResource AccentBrush}" StrokeDashArray="8 4"
                         RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="ShutdownSpin"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <TextBlock Text="Shutting down GiftDeck" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource TextBrush}"/>
                <TextBlock x:Name="ShutdownStep" Style="{StaticResource Muted}" FontSize="13" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                <TextBlock Text="GiftDeck closes by itself when everything has stopped." Style="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Center" Margin="0,18,0,0"/>
            </StackPanel>
        </Grid>
        <!-- Drag the panel's left edge to make chat and gifts wider or narrower -->
        <GridSplitter x:Name="LiveSplitter" Grid.Column="2" Width="5" HorizontalAlignment="Left" Background="Transparent" ResizeBehavior="PreviousAndCurrent" ResizeDirection="Columns" Cursor="SizeWE"/>
    </Grid>
</Window>
