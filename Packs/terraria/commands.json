[
  {
    "id": "invasion", "name": "Start an invasion", "category": "Enemies",
    "description": "Goblin Army, Frost Legion, Pirates or Martian Madness. If an invasion is already running, this ends it instead. Terraria only starts an invasion when a player has at least 200 max life.",
    "args": [
      {"name": "type", "label": "Invasion", "type": "choice", "default": "goblins", "choices": ["goblins", "snowmen", "pirates", "martians"]}
    ],
    "run": "/worldevent invasion {type}"
  },
  {
    "id": "pumpkin_moon", "name": "Pumpkin Moon", "category": "Enemies",
    "description": "Starts the Pumpkin Moon at the chosen wave. Very hard before late Hardmode. It only lasts until morning, so use it at night.",
    "args": [
      {"name": "wave", "label": "Wave (1 to 15)", "type": "number", "default": "1"}
    ],
    "run": "/worldevent invasion pumpkinmoon {wave}"
  },
  {
    "id": "frost_moon", "name": "Frost Moon", "category": "Enemies",
    "description": "Starts the Frost Moon at the chosen wave. Very hard before late Hardmode. It only lasts until morning, so use it at night.",
    "args": [
      {"name": "wave", "label": "Wave (1 to 20)", "type": "number", "default": "1"}
    ],
    "run": "/worldevent invasion frostmoon {wave}"
  },
  {
    "id": "blood_moon", "name": "Blood Moon (on/off)", "category": "Enemies",
